<div class="layout layout--col">
  {% assign n = text.size %}
  {% if n <= 100 %}{% assign size = "xlarge" %}{% assign big = "xxlarge" %}
  {% elsif n <= 200 %}{% assign size = "large" %}{% assign big = "xlarge" %}
  {% else %}{% assign size = "base" %}{% assign big = "large" %}{% endif %}
  {% if paragraphs.size > 0 %}
  <div class="content content--{{ size }} lg:content--{{ big }} flex flex--col flex--left gap--xsmall" data-content-limiter="true">
  {% for p in paragraphs %}<p>{{ p | newline_to_br }}</p>{% endfor %}
  </div>
  {% else %}
  <span class="label">No post right now. Check back soon!</span>
  {% endif %}
  <div class="grid grid--cols-4">
    <div class="col col--span-3">
      <div class="description description--large text--black text--center">Scan to create your own</div>
    </div>
    <div class="col col--span-1">
      <div class="w--full aspect--1/1">{{ "https://linkedinmadlibs.com" | qr_code }}</div>
    </div>
  </div>
</div>
<div class="title_bar"><span class="title">LinkedIn Mad Libs</span><span class="instance">linkedinmadlibs.com</span></div>
