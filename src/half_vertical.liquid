<div class="layout layout--col layout--stretch-y">
  {% assign n = text.size %}
  {% if n <= 110 %}{% assign size = "small" %}{% assign big = "base" %}
  {% elsif n <= 190 %}{% assign size = "xsmall" %}{% assign big = "small" %}
  {% else %}{% assign size = "xxsmall" %}{% assign big = "xsmall" %}{% endif %}
  {% if text %}
    <div class="value value--{{ size }} lg:value--{{ big }}">{{ text | truncate: 300 | newline_to_br }}</div>
  {% else %}
    <span class="label">No post right now. Check back soon!</span>
  {% endif %}
  <div class="text--center">
    {% render "qr_code", size: 90 %}
    <span class="label label--small">Scan to create your own</span>
  </div>
</div>
<div class="title_bar"><span class="title">LinkedIn Mad Libs</span><span class="instance">linkedinmadlibs.com</span></div>
