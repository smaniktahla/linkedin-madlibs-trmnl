<div class="layout">
  <div class="grid grid--cols-4">
    <div class="col--span-3">
      {% assign n = text.size %}
      {% if n <= 150 %}{% assign size = "base" %}{% assign big = "large" %}
      {% elsif n <= 330 %}{% assign size = "small" %}{% assign big = "base" %}
      {% elsif n <= 520 %}{% assign size = "xsmall" %}{% assign big = "small" %}
      {% else %}{% assign size = "xxsmall" %}{% assign big = "xsmall" %}{% endif %}
      {% if text %}
        <div class="value value--{{ size }} lg:value--{{ big }}">{{ text | truncate: 600 | newline_to_br }}</div>
      {% else %}
        <span class="label">No post right now. Check back soon!</span>
      {% endif %}
    </div>
    <div class="col--span-1 text--center">
      {% render "qr_code", size: 140 %}
      <span class="label label--small">Scan to create your own</span>
    </div>
  </div>
</div>
<div class="title_bar"><span class="title">LinkedIn Mad Libs</span><span class="instance">linkedinmadlibs.com</span></div>
