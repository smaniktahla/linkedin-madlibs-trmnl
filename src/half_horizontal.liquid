<div class="layout">
  <div class="grid grid--cols-4">
    <div class="col--span-3">
      {% assign n = text.size %}
      {% if n <= 120 %}{% assign size = "small" %}{% assign big = "base" %}
      {% elsif n <= 190 %}{% assign size = "xsmall" %}{% assign big = "small" %}
      {% else %}{% assign size = "xxsmall" %}{% assign big = "xsmall" %}{% endif %}
      {% if text %}
        <div class="value value--{{ size }} lg:value--{{ big }}">{{ text | truncate: 240 | newline_to_br }}</div>
      {% else %}
        <span class="label">No post right now. Check back soon!</span>
      {% endif %}
    </div>
    <div class="col--span-1 text--center">
      <div style="display:flex;flex-direction:column;align-items:center;">
