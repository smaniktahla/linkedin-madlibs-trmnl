<div class="layout">
  <div class="grid grid--cols-5">
    <div class="col--span-4">
      {% assign n = text.size %}
      {% if n <= 120 %}{% assign size = "small" %}{% assign big = "large" %}{% assign c = 5 %}{% assign cbig = 9 %}
      {% elsif n <= 190 %}{% assign size = "xsmall" %}{% assign big = "base" %}{% assign c = 7 %}{% assign cbig = 13 %}
      {% else %}{% assign size = "xxsmall" %}{% assign big = "small" %}{% assign c = 9 %}{% assign cbig = 20 %}{% endif %}
      {% if text %}
        <div class="value value--{{ size }} lg:value--{{ big }}" data-clamp="{{ c }}" data-clamp-lg="{{ cbig }}">{{ text | newline_to_br }}</div>
      {% else %}
        <span class="label">No post right now. Check back soon!</span>
      {% endif %}
    </div>
    <div class="col--span-1 text--center">
      <div class="w--full aspect--1/1">{{ "https://linkedinmadlibs.com" | qr_code }}</div>
      <span class="label text--black">Create your own</span>
    </div>
  </div>
</div>
<div class="title_bar"><span class="title">LinkedIn Mad Libs</span><span class="instance">linkedinmadlibs.com</span></div>
