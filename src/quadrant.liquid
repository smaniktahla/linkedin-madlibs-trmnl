<div class="layout layout--col">
  {% assign n = text.size %}
  {% if n <= 90 %}{% assign size = "small" %}{% assign big = "base" %}
  {% elsif n <= 150 %}{% assign size = "xsmall" %}{% assign big = "small" %}
  {% else %}{% assign size = "xxsmall" %}{% assign big = "xsmall" %}{% endif %}
  {% if text %}
    <div class="value value--{{ size }} lg:value--{{ big }}">{{ text | truncate: 230 | newline_to_br }}</div>
  {% else %}
    <span class="label">No post right now. Check back soon!</span>
  {% endif %}
</div>
<div class="title_bar"><span class="title">LinkedIn Mad Libs</span><span class="instance">linkedinmadlibs.com</span></div>
