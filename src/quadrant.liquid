<div class="layout layout--col">
  {% assign n = text.size %}
  {% if n <= 90 %}{% assign size = "small" %}{% assign big = "base" %}{% assign c = 5 %}{% assign cbig = 7 %}
  {% elsif n <= 150 %}{% assign size = "xsmall" %}{% assign big = "small" %}{% assign c = 6 %}{% assign cbig = 10 %}
  {% else %}{% assign size = "xxsmall" %}{% assign big = "xsmall" %}{% assign c = 8 %}{% assign cbig = 12 %}{% endif %}
  {% if text %}
    <div class="value value--{{ size }} lg:value--{{ big }}" data-clamp="{{ c }}" data-clamp-lg="{{ cbig }}">{{ text | newline_to_br }}</div>
  {% else %}
    <span class="label">No post right now. Check back soon!</span>
  {% endif %}
</div>
<div class="title_bar"><span class="title">LinkedIn Mad Libs</span><span class="instance">linkedinmadlibs.com</span></div>
